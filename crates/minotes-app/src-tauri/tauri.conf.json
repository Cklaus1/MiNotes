{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiNotes",
  "version": "0.1.0",
  "identifier": "com.minotes.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MiNotes",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost attachment: http://attachment.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "media-src": "'self' data: blob: attachment: http://attachment.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost attachment: http://attachment.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1420 ws://localhost:1421",
        "worker-src": "'self' blob:",
        "media-src": "'self' data: blob: attachment: http://attachment.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fusen World",
    "copyright": "Copyright (c) 2026 Fusen World",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Local-first outliner and notes app",
    "longDescription": "MiNotes is a local-first outliner and notes app: bidirectional links, a graph view, whiteboards, encrypted notebooks, Git sync, and import from Evernote and Obsidian. Your notes stay on your machine, in notebooks you choose.",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "MiNotes",
        "displayLanguageSelector": false
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {
    "opener": {}
  }
}
